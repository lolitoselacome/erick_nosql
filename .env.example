# =====================================================================
# CETIA NoSQL - Variables de entorno
#
# Copia este archivo como .env y llena los dos valores. El archivo .env
# nunca se sube a GitHub; este .env.example si, y por eso no lleva nada
# secreto.
#
# Las dos cadenas llevan usuario y contrasena. Van aqui, en el archivo,
# y no se pegan en ningun chat ni se suben a ningun lado.
# =====================================================================

# ---------------------------------------------------------------------
# MongoDB Atlas, a donde se escribe
#
# En Atlas: Clusters, boton Connect del cluster cetia, Drivers, y copia
# la cadena. Donde dice <db_password> va la contrasena del usuario de
# base de datos que creaste en Database Access.
# ---------------------------------------------------------------------
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cetia.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base dentro del cluster. Si no se pone, se usa cetia.
MONGODB_BASE=cetia

# ---------------------------------------------------------------------
# Supabase, de donde se lee
#
# En Supabase: el proyecto CETIA, boton Connect de arriba, pestana ORMs
# o Direct connection, y copia la cadena de PostgreSQL. Lleva la
# contrasena de la base del proyecto.
#
# Solo se usa para leer: la migracion no escribe nada en Supabase.
# ---------------------------------------------------------------------
SUPABASE_DB_URI=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres

# ---------------------------------------------------------------------
# MongoDB local, el de Docker
#
# Solo lo usa el aplicador de roles cuando se corre desde la
# computadora. Si no se pone, usa este mismo valor.
# ---------------------------------------------------------------------
MONGODB_URI_LOCAL=mongodb://localhost:27017/?directConnection=true

# ---------------------------------------------------------------------
# API de administracion de Atlas
#
# Los roles personalizados no se pueden crear con el driver: Atlas no
# deja administrar roles por ahi, ni siquiera con atlasAdmin. Se crean
# por la consola o por esta API, y el aplicador de roles usa la API.
#
# La llave se saca en la organizacion, en Access Manager, API Keys, y
# necesita el permiso Project Owner sobre el proyecto. La mitad privada
# solo se ve una vez, cuando se crea.
#
# ATLAS_GROUP_ID es el identificador del proyecto: son los 24 caracteres
# que salen en la direccion de Atlas, despues de /v2/.
# ---------------------------------------------------------------------
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_GROUP_ID=
